{
  "name": "express-workshop",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "npm run clean && tsc --project tsconfig.json && npm run copy-assets && npm run copy-views",
    "clean": "rm -Rf dist",
    "copy-assets": "cp -R src/assets dist",
    "copy-views": "cp -R src/views dist",
    "start": "ts-node ./src/index.ts",
    "start:dist": "node ./dist/index.js",
    "start:hot": "ts-node-dev --respawn --transpile-only ./src/index.ts",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruettenm/express-wokshop.git"
  },
  "author": "Matthias Rütten <matthias.ruetten@codecentric.de>",
  "bugs": {
    "url": "https://github.com/ruettenm/express-wokshop/issues"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "ejs": "^3.1.6",
    "express": "^4.17.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@jest-mock/express": "^1.4.1",
    "@types/express": "^4.17.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/supertest": "^2.0.11",
    "jest": "^29.7.0",
    "prettier": "2.3.1",
    "supertest": "^6.1.3",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0"
  }
}
