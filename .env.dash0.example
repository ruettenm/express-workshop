# Copy to .env.dash0 (git-ignored) and fill in the two placeholders.
# OTLP endpoint: Dash0 -> Settings -> Endpoints (OTLP via HTTP)
# Auth token:    Dash0 -> Settings -> Auth Tokens (an ingest-only auth_... token is enough)

OTEL_SERVICE_NAME=express-workshop
OTEL_RESOURCE_ATTRIBUTES=service.version=1.0.0,deployment.environment.name=local

OTEL_LOGS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_NODE_ENABLED_INSTRUMENTATIONS=http,express,pino

OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingress.<REGION>.aws.dash0.com
# Append ,Dash0-Dataset=<name> to send to a dataset other than "default"
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <YOUR_DASH0_AUTH_TOKEN>
