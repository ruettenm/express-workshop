# OpenTelemetry settings for sending traces from express-workshop to Dash0.
#
# Usage:
#   cp .env.example .env        # .env is git-ignored; put your real token there
#   set -a; . ./.env; set +a    # export the variables into your shell
#                               # (Node 14 has no --env-file flag)
#   npm run build && npm run start:otel     # compiled app (dist/)
#   npm run start:otel:dev                  # ts-node, no build step
#
# To try it without Dash0, set OTEL_TRACES_EXPORTER=console and
# OTEL_METRICS_EXPORTER=none: spans are printed to stdout instead.

# Service identity (taken from package.json)
OTEL_SERVICE_NAME=express-workshop
OTEL_RESOURCE_ATTRIBUTES=service.version=1.0.0,deployment.environment.name=development

# Which signals to export. Logs stay off: console.log and morgan do not go
# through OpenTelemetry.
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none

# Dash0 OTLP/HTTP endpoint: copy it from Dash0 → Settings → Endpoints (OTLP via HTTP).
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://<your-dash0-otlp-http-endpoint>

# Dash0 auth token: create one in Dash0 → Settings → Auth Tokens.
# To send to a dataset other than "default", append ",Dash0-Dataset=<dataset>".
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <your-dash0-auth-token>

# Only instrument what the app uses: incoming HTTP requests and Express
# middleware and routes.
OTEL_NODE_ENABLED_INSTRUMENTATIONS=http,express
